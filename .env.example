# Puerto del API
PORT=4000

# Postgres local (docker-compose). Para Supabase, reemplazar por la connection string (session pooler).
DATABASE_URL=postgres://colibri:colibri_secret@localhost:5433/colibri

# Seguridad
JWT_SECRET=cambia-este-secreto-en-produccion

# Orígenes permitidos (CORS): '*' en dev; en producción la lista exacta de tus
# sitios web, separados por coma. La app móvil no necesita CORS.
CORS_ORIGIN=*
# CORS_ORIGIN=https://colibri.app,https://www.colibri.app
