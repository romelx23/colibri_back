# Puerto del API
PORT=4000

# Postgres local (docker-compose). Para Supabase, reemplazar por la connection string (session pooler).
DATABASE_URL=postgres://colibri:colibri_secret@localhost:5433/colibri

# Seguridad
JWT_SECRET=cambia-este-secreto-en-produccion

# Origen permitido (CORS)
CORS_ORIGIN=*
